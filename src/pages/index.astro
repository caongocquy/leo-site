---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AtlasArt from '../components/AtlasArt.astro';
import Icon from '../components/Icon.astro';
import { expertise, site, stack } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const atlas = projects.find((project) => project.id === 'code-atlas');
const otherProjects = projects.filter((project) => project.id !== 'code-atlas').slice(0, 3);
---
<BaseLayout>
  <section class="hero section-grid" aria-labelledby="hero-title">
    <div class="hero-copy">
      <div class="eyebrow"><span class="pulse-dot"></span> HELLO, I'M LEO <span class="eyebrow-rule"></span> MOBILE ENGINEER</div>
      <h1 id="hero-title">Engineering <em>better</em> mobile experiences<span class="period">.</span></h1>
      <p class="hero-desc">I build thoughtful mobile apps and the open-source tools behind better development workflows. From native details to code intelligence, I care about making complex things feel simple.</p>
      <div class="hero-actions">
        <a href="#projects" class="button button-primary">Explore my work <Icon name="arrow-up-right" size={15} /></a>
        <a href={site.github} class="button button-outline" target="_blank" rel="noopener noreferrer">GitHub profile <Icon name="arrow-up-right" size={15} /></a>
      </div>
      <div class="hero-notes"><span>React Native & native</span><span>Mobile architecture</span><span>Open source</span></div>
    </div>
    <div class="hero-visual" aria-label="Illustration of React Native OTP component and a mobile verification screen" role="img">
      <div class="visual-overline"><span>ENGINEERED FOR MOBILE</span><span class="visual-overline-status">iOS <i></i> ANDROID</span></div>
      <div class="hero-art-stage" aria-hidden="true">
        <div class="hero-code-card">
          <div class="code-title"><span class="window-lights"><i></i><i></i><i></i></span><span>VerifyPhone.tsx</span><span class="code-language">TSX</span></div>
          <div class="code-lines">
            <span class="code-keyword">import <span class="code-text">&#123; OtpInput &#125;</span> from</span>
            <span class="code-string">  '@leo-showdar/react-native-otp-input-kit';</span>
            <span class="code-gap"></span>
            <span class="code-keyword">export function <span class="code-function">VerifyPhone</span>() &#123;</span>
            <span class="code-text">  return (</span>
            <span class="code-text">    &lt;OtpInput</span>
            <span class="code-string">      length=&#123;6&#125;</span>
            <span class="code-string">      autoFocus</span>
            <span class="code-string">      onComplete=&#123;verify&#125;</span>
            <span class="code-text">    /&gt;</span>
            <span class="code-text">  );</span>
            <span class="code-text">&#125;</span>
          </div>
          <div class="code-status"><span class="status-led"></span> REACT NATIVE · TYPESCRIPT</div>
        </div>
        <div class="hero-phone" aria-hidden="true">
          <div class="hero-phone-screen">
            <div class="hero-phone-island"></div>
            <div class="hero-phone-header"><span>9:41</span><span>▂ ▰</span></div>
            <div class="verify-symbol"><Icon name="lock" size={21} /></div>
            <span class="verify-step">SECURE VERIFICATION</span>
            <strong>Enter your code.</strong>
            <p>We sent a 6-digit verification code to your phone.</p>
            <div class="verify-cells"><span>3</span><span>8</span><span>2</span><span class="verify-caret"></span><span></span><span></span></div>
            <div class="verify-resend">Resend in <b>00:28</b></div>
            <div class="verify-action">Continue <Icon name="arrow-right" size={13} /></div>
          </div>
        </div>
      </div>
      <div class="visual-footnote"><span>REAL COMPONENT · OPEN SOURCE</span><span>01 / 04</span></div>
    </div>
  </section>

  <section id="expertise" class="section-block top-lined" aria-labelledby="expertise-title">
    <div class="section-intro"><span class="section-eyebrow">01 / WHAT I DO</span><h2 id="expertise-title">Engineering beyond <span>the screen.</span></h2><p>I think about the whole experience: what users see, what platforms need, and what makes software sustainable.</p></div>
    <div class="expertise-grid">
      {expertise.map((item) => (
        <article class="expertise-card">
          <div class="expertise-card-top"><span class="expertise-icon"><Icon name={item.icon} size={27} /></span><span class="index-number">{item.number}</span></div>
          <h3>{item.title}</h3><p>{item.description}</p>
          <div class="mini-tags">{item.tags.map((tag) => <span>{tag}</span>)}</div>
        </article>
      ))}
    </div>
  </section>

  <section id="experience" class="section-block experience-section top-lined" aria-labelledby="experience-title">
    <div class="section-intro"><span class="section-eyebrow">02 / EXPERIENCE</span><h2 id="experience-title">Real products. <span>Real constraints.</span></h2><p>The work that shapes my approach to building reliable, user-friendly software.</p></div>
    <div class="experience-grid">
      <article class="experience-card"><div class="experience-meta"><span>PRODUCTION ENGINEERING</span><span>01</span></div><h3>Mobile experiences in fintech</h3><p>Building and owning complex React Native workflows in cross-functional environments, from feature delivery to integration and reliability issues.</p><div class="experience-tech">React Native <i>·</i> TypeScript <i>·</i> Product Engineering</div></article>
      <article class="experience-card"><div class="experience-meta"><span>PLATFORM & NATIVE</span><span>02</span></div><h3>Across iOS and Android</h3><p>Working at the JavaScript–native boundary to refine transitions, integrate platform capabilities, and deliver maintainable mobile UI.</p><div class="experience-tech">Swift <i>·</i> Kotlin <i>·</i> UI Performance</div></article>
    </div>
  </section>

  <section id="projects" class="section-block projects-section" aria-labelledby="projects-title">
    <div class="section-heading-row"><div class="section-intro"><span class="section-eyebrow">03 / SELECTED WORK</span><h2 id="projects-title">Open source, <span>built with purpose.</span></h2><p>Useful experiments and products I build, refine, and share with other developers.</p></div><a class="section-view-all" href="/projects">View all projects <Icon name="arrow-up-right" size={15} /></a></div>
    {atlas && (
      <article class="featured-project">
        <div class="featured-body"><div class="featured-eyebrow"><Icon name="sparkles" size={15} class="featured-star" /> FEATURED PROJECT / CODE INTELLIGENCE</div><h3>{atlas.data.title}</h3><p>{atlas.data.summary}</p><div class="feature-tags">{atlas.data.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}</div><a class="featured-link" href={`/projects/${atlas.id}/`}>Explore Code Atlas <Icon name="arrow-up-right" size={15} /></a></div>
        <AtlasArt />
      </article>
    )}
    <div class="projects-grid">{otherProjects.map((project) => <ProjectCard project={project} />)}</div>
  </section>

  <section id="about" class="about-section top-lined" aria-labelledby="about-title">
    <div><span class="section-eyebrow">04 / ABOUT ME</span><h2 id="about-title">Mobile by craft.<br /><span>Builder by curiosity.</span></h2><p>I'm Leo, a mobile engineer who enjoys solving the hard parts—architecture, native integrations, performance, and developer experience. My open-source projects are where I turn those lessons into tools other developers can use.</p><a class="about-link" href={site.github} target="_blank" rel="noopener noreferrer">Connect on GitHub <Icon name="arrow-up-right" size={15} /></a></div>
    <div class="toolbox"><span class="section-eyebrow">MY TOOLBOX</span><div class="stack-tags">{stack.map((item) => <span>{item}</span>)}</div><div class="toolbox-note"><Icon name="terminal" size={14} class="toolbox-terminal" /> Always learning. Always building.</div></div>
  </section>
  <div class="bottom-cta"><div><span>HAVE SOMETHING IN MIND?</span><h2>Let's build something <em>meaningful.</em></h2></div><a href={site.github} target="_blank" rel="noopener noreferrer" class="button button-primary">Find me on GitHub <Icon name="arrow-up-right" size={15} /></a></div>
</BaseLayout>
