---
import type { CollectionEntry } from 'astro:content';
import ProjectVisual from './ProjectVisual.astro';
import Icon from './Icon.astro';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
---
<a class="project-card" href={`/projects/${project.id}/`} aria-label={`View ${project.data.title} project details`}>
  <div class="project-card-media">
    <ProjectVisual variant={project.data.icon} />
    <span class="project-card-open"><Icon name="arrow-up-right" size={16}/></span>
  </div>
  <div class="project-card-content">
    <span class="project-card-kicker">{project.data.category}</span>
    <h3>{project.data.title}</h3>
    <p>{project.data.summary}</p>
  </div>
  <div class="project-card-bottom">
    <span>{project.data.tags.slice(0, 2).join(' · ')}</span>
    <span>View project <span aria-hidden="true">→</span></span>
  </div>
</a>
