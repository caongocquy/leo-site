---
import { localeFromPath, localizedPath, ui } from '../i18n/translations';
const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);
const path = Astro.url.pathname;
---
<nav class="language-switch" aria-label={locale === 'vi' ? 'Ngôn ngữ' : 'Language'}>
  <a href={localizedPath(path, 'en')} lang="en" aria-label={t.switchEnglish} aria-current={locale === 'en' ? 'page' : undefined} title="English"><svg class="flag-icon" viewBox="0 0 60 40" aria-hidden="true" focusable="false">
      <defs><clipPath id="flag-uk-clip"><rect width="60" height="40" rx="2"/></clipPath></defs>
      <g clip-path="url(#flag-uk-clip)">
        <rect width="60" height="40" fill="#012169"/>
        <path d="M-6 -4 66 44 M66 -4 -6 44" stroke="#fff" stroke-width="10"/>
        <path d="M-6 -4 66 44 M66 -4 -6 44" stroke="#C8102E" stroke-width="4"/>
        <path d="M30 0V40 M0 20H60" stroke="#fff" stroke-width="14"/>
        <path d="M30 0V40 M0 20H60" stroke="#C8102E" stroke-width="7"/>
      </g>
    </svg></a>
  <a href={localizedPath(path, 'vi')} lang="vi" aria-label={t.switchVietnamese} aria-current={locale === 'vi' ? 'page' : undefined} title="Tiếng Việt"><svg class="flag-icon" viewBox="0 0 60 40" aria-hidden="true" focusable="false">
      <rect width="60" height="40" rx="2" fill="#DA251D"/>
      <path d="M30 7.5 33.3 17.2 43.5 17.2 35.2 23.1 38.5 32.7 30 26.8 21.5 32.7 24.8 23.1 16.5 17.2 26.7 17.2Z" fill="#FFFF00"/>
    </svg></a>
</nav>
<style>
  .language-switch { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 3px; border: 1px solid var(--line); border-radius: 9px; padding: 3px; background: var(--surface); }
  .language-switch a { display: grid; place-items: center; width: 29px; height: 28px; border-radius: 6px; font-size: 17px; line-height: 1; text-decoration: none; filter: saturate(.6); opacity: .7; transition: filter .15s ease, opacity .15s ease, background-color .15s ease; }
  .language-switch .flag-icon { display: block; width: 22px; height: 15px; border-radius: 2px; box-shadow: 0 0 0 1px rgba(128, 128, 128, .18); }
  .language-switch a:hover, .language-switch a[aria-current="page"] { background: var(--icon-surface); filter: none; opacity: 1; }
  .language-switch a[aria-current="page"] { box-shadow: inset 0 0 0 1px var(--line-accent); }
  .language-switch a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media(max-width: 560px) { .language-switch { padding: 2px; gap: 1px; } .language-switch a { width: 27px; height: 27px; } .language-switch .flag-icon { width: 21px; height: 14px; } }
  @media(prefers-reduced-motion: reduce) { .language-switch a { transition: none; } }
</style>
