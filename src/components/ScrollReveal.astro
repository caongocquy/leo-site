---
// Site-wide progressive enhancement for below-the-fold content.
---
<style is:global>
  /* Nodes only become hidden after JavaScript opts them in. */
  [data-scroll-reveal].scroll-reveal-pending { opacity: 0; }
  [data-scroll-reveal].scroll-reveal-enter {
    animation: scroll-reveal-enter .62s cubic-bezier(.2,.8,.2,1) var(--scroll-reveal-delay, 0ms) both;
  }
  @keyframes scroll-reveal-enter {
    from { opacity: 0; translate: 0 20px; }
    to { opacity: 1; translate: 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-scroll-reveal].scroll-reveal-pending { opacity: 1; }
    [data-scroll-reveal].scroll-reveal-enter { animation: none; }
  }
  @media print {
    [data-scroll-reveal].scroll-reveal-pending { opacity: 1; }
    [data-scroll-reveal].scroll-reveal-enter { animation: none; }
  }
</style>

<script>
  // HTML stays readable if JS is disabled, Observer is unavailable, or reduced motion is on.
  const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!motionPreference.matches && 'IntersectionObserver' in window) {
    const candidates = Array.from(document.querySelectorAll<HTMLElement>('main [data-scroll-reveal]'));
    const staggerCounts = new WeakMap<Element, number>();
    const staggerParents = '.expertise-grid, .experience-grid, .projects-grid, .gallery-grid';

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) reveal(entry.target as HTMLElement);
      }
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.01 });

    function reveal(element: HTMLElement) {
      if (!element.classList.contains('scroll-reveal-pending')) return;
      observer.unobserve(element);
      element.classList.remove('scroll-reveal-pending');
      element.classList.add('scroll-reveal-enter');
      const cleanup = () => {
        element.classList.remove('scroll-reveal-enter');
        element.style.removeProperty('--scroll-reveal-delay');
      };
      element.addEventListener('animationend', cleanup, { once: true });
    }

    for (const element of candidates) {
      const rect = element.getBoundingClientRect();
      // Above-the-fold and already-scrolled-past content must never flash or become hidden.
      if (rect.top <= window.innerHeight * .9 || rect.bottom <= 0) continue;

      const parent = element.parentElement;
      if (parent?.matches(staggerParents)) {
        const siblingIndex = staggerCounts.get(parent) ?? 0;
        staggerCounts.set(parent, siblingIndex + 1);
        element.style.setProperty('--scroll-reveal-delay', `${Math.min(siblingIndex % 3, 2) * 75}ms`);
      }
      element.classList.add('scroll-reveal-pending');
      observer.observe(element);
    }

    // Deep links, keyboard tabbing, and find-in-page must never focus invisible controls.
    document.addEventListener('focusin', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const pending = target.closest<HTMLElement>('[data-scroll-reveal].scroll-reveal-pending');
      if (pending) reveal(pending);
    });

    // If reduced motion becomes enabled while viewing the page, reveal everything.
    motionPreference.addEventListener('change', () => {
      if (!motionPreference.matches) return;
      for (const element of candidates) {
        observer.unobserve(element);
        element.classList.remove('scroll-reveal-pending', 'scroll-reveal-enter');
        element.style.removeProperty('--scroll-reveal-delay');
      }
      observer.disconnect();
    });
  }
</script>
