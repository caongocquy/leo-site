---
import { Smartphone, Layers, Terminal, ArrowUpRight, ArrowRight, ArrowLeft, SunMoon, Sparkles, LockKeyhole } from '@lucide/astro';
type IconName = 'mobile' | 'layers' | 'terminal' | 'arrow-up-right' | 'arrow-right' | 'arrow-left' | 'sun-moon' | 'sparkles' | 'lock';
interface Props { name: IconName; size?: number; class?: string; }
const { name, size = 24, class: className } = Astro.props;
const icons = {
  mobile: Smartphone,
  layers: Layers,
  terminal: Terminal,
  'arrow-up-right': ArrowUpRight,
  'arrow-right': ArrowRight,
  'arrow-left': ArrowLeft,
  'sun-moon': SunMoon,
  sparkles: Sparkles,
  lock: LockKeyhole,
} as const;
const Component = icons[name];
---
<Component size={size} stroke-width={1.75} class={className} aria-hidden="true" focusable="false" />
