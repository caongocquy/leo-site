---
import { site } from '../data/site';
import Icon from './Icon.astro';
import { localeFromPath, localizedPath, ui } from '../i18n/translations';
const locale = localeFromPath(Astro.url.pathname);
const t = ui(locale);
---
<footer class="site-footer">
  <div>
    <span class="footer-brand" role="img" aria-label="Leo — Engineer / Builder"><img class="brand-image brand-image-on-dark" src="/brand/leo-horizontal-on-dark.svg" alt="" width="920" height="240" decoding="async" /><img class="brand-image brand-image-on-light" src="/brand/leo-horizontal-on-light.svg" alt="" width="920" height="240" decoding="async" /></span>
    <span>{t.footerTagline}</span>
  </div>
  <div class="footer-links">
    <a href={localizedPath("/journey/",locale)}>{locale === "vi" ? "Hành trình" : "Journey"}</a>
    <a href={localizedPath("/projects",locale)}>{t.navProjects}</a>
    <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="arrow-up-right" size={13}/></a>
    <span>© {new Date().getFullYear()} Leo</span>
  </div>
</footer>
